#2

from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

# Optional: detach option prevents auto-close even if errors occur
options = webdriver.ChromeOptions()
options.add_experimental_option("detach", True)

driver = webdriver.Chrome(options=options)
driver.get("https://www.saucedemo.com/")

# Setup explicit wait (up to 10 seconds)
wait = WebDriverWait(driver, 10)

# Login
username = driver.find_element(By.ID, "user-name")
password = driver.find_element(By.NAME, "password")
login = driver.find_element(By.ID, "login-button")

username.send_keys("standard_user")
password.send_keys("secret_sauce")

print(username.get_attribute("placeholder"))
print(login.is_enabled())
print(username.is_displayed())

login.click()

# Wait for the onesie button to be clickable before clicking
onesie_btn = wait.until(EC.element_to_be_clickable((By.ID, "add-to-cart-sauce-labs-onesie")))
onesie_btn.click()

# Wait for the cart link to be clickable before clicking
cart = driver.find_element(By.CLASS_NAME, "shopping_cart_link")
cart.click()

input("Press Enter in console to quit...")
driver.quit()

#3

from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.common.exceptions import TimeoutException

driver = webdriver.Chrome()
driver.maximize_window()
driver.get("https://www.flipkart.com/")

# Use a short timeout (3 seconds) for optional popups
short_wait = WebDriverWait(driver, 3)
wait =  WebDriverWait(driver,10)

try:
    close_btn = short_wait.until(
        EC.element_to_be_clickable((
            By.XPATH, 
            "//span[@class='_30XB9F'] | //button[contains(text(),'✕')] | //span[text()='✕']"
        ))
    )
    close_btn.click()
    print("Login popup closed successfully!")
except TimeoutException:
    print("No login popup appeared. Proceeding with main page...")
try:
    login_click = wait.until(EC.element_to_be_clickable((By.XPATH,"//span[@class='v1zwn28'] | //button[contains(text(),'Login')]")))
    login_click.click()
    print("login button clicked")


except Exception as e:
    print("error in login button click")

try:
    input_number = wait.until(EC.element_to_be_clickable((By.XPATH,"//input[@class='jwCbxy'] | //input[@type='number']")))
    input_number.click()
    input_number.send_keys("8925759506")
    print("number entered")
except Exception as e:
    print("error in number entering")

try:
    click_enter = wait.until(EC.element_to_be_clickable((By.XPATH,"//button[contains(text(),'Continue')]"))).click()
    print("check for otp")
except Exception as e:
    print("error in continue button")
    otp = input("enter the otp")

try:
    # Target the actual input tag, not the parent div wrapper
    otp_input = wait.until(
        EC.presence_of_element_located((
            By.XPATH,
            "//form//input[@type='number'] | //div[contains(@class, 'OTP')]//input"
        ))
    )
    
    otp = input("Check your phone and enter the OTP in terminal: ")
    otp_input.send_keys(otp)
    print("OTP submitted. Successfully logged in!")
except Exception as e:
    print(f"Error in OTP phase: {e}")
